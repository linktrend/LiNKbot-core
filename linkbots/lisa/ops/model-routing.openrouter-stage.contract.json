{
  "_comment": "Mac Mini lisa-stage OpenRouter-only routing overlay. Workshop semantic slots stay in model-routing.contract.json; this fragment mirrors the stage runtime refs. No secrets. Never request direct provider keys — OpenRouter credential only. Do not copy into ~/.openclaw-lisa without a separately approved rollout. PDF remains approved_unverified; first-production-proof receipt required before success claims.",
  "liveMutationAllowed": false,
  "paidSpendEnablementAllowed": false,
  "contractVersion": "2026-08-03-openrouter-only-stage-routing",
  "sourceSemanticContractVersion": "2026-08-01-ocp-w30-approved-pdf-routing",
  "provider": "openrouter",
  "credentialPosture": {
    "mode": "openrouter_only",
    "allowedCredentialNames": ["OPENROUTER_API_KEY"],
    "forbidDirectProviderKeys": true,
    "forbiddenCredentialNamePrefixes": [
      "OPENAI_",
      "ZAI_",
      "MINIMAX_",
      "MOONSHOT_",
      "NVIDIA_",
      "GOOGLE_"
    ],
    "_comment": "Credential *names* only. Never store or request secret values here."
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/openai/gpt-5.6-luna",
        "fallbacks": [
          "openrouter/z-ai/glm-5.2",
          "openrouter/moonshotai/kimi-k3",
          "openrouter/google/gemini-3.5-flash-lite"
        ]
      },
      "imageModel": {
        "primary": "openrouter/minimax/minimax-m3"
      },
      "pdfModel": {
        "primary": "openrouter/minimax/minimax-m3",
        "_comment": "Stage runtime key is agents.defaults.pdfModel (not documentModels). Capability remains approved_unverified."
      },
      "thinkingDefault": "medium"
    }
  },
  "evaluationOnly": {
    "ref": "openrouter/nvidia/nemotron-3-super-120b-a12b",
    "enabledInDefaults": false,
    "forbidFreeTiers": true,
    "inModelPolicyAllow": false
  },
  "pdfDocumentModelsCutover": {
    "state": "enabled_candidate",
    "documentModelsEnabled": true,
    "capabilityStatus": "approved_unverified",
    "candidateRef": "openrouter/minimax/minimax-m3",
    "runtimeConfigKey": "agents.defaults.pdfModel",
    "firstProof": "controlled_stage_or_production_rollout",
    "requiresFirstProductionProofReceipt": true,
    "alternatePaidDocumentRoutingAllowed": false,
    "rollback": {
      "onProviderOrModelValidationFailure": "disable_pdf_document_routing_only",
      "preserveTextImageDefaultFallbackService": true,
      "alternatePaidDocumentRoutingAllowed": false,
      "failureEventType": "pdf_document_routing_validation_failure"
    }
  }
}
