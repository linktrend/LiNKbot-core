[Unit]
Description=OpenClaw Lisa gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=openclaw-lisa
Group=openclaw-lisa
WorkingDirectory=/opt/openclaw_prime
EnvironmentFile=/etc/openclaw/lisa/service.env
Environment=OPENCLAW_NO_RESPAWN=1
Environment=OPENCLAW_PROFILE=lisa
ExecStart=/usr/bin/env node /opt/openclaw_prime/openclaw.mjs --profile lisa gateway run --bind loopback --port ${OPENCLAW_GATEWAY_PORT}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
TimeoutAbortSec=30s
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=yes
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-lisa
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openclaw/lisa/state /var/log/openclaw/lisa
UMask=0077

[Install]
WantedBy=multi-user.target
