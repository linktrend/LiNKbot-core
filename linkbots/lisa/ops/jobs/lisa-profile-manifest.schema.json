{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "profileId", "activation", "timeZone", "jobDesiredState", "declarations", "exclusions", "hardStops"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "const": "lisa" },
    "timeZone": { "const": "Asia/Taipei" },
    "activation": { "type": "object", "required": ["profile", "sourceSchedules", "liveMutation"] },
    "jobDesiredState": {
      "type": "object",
      "required": ["source", "version", "owner", "executor", "operationalDeclarationCount", "separateMemoryDreamingRegistration", "excludedCronFamilies"],
      "properties": {
        "source": { "const": "linkbots/lisa/ops/jobs/lisa-job-desired-state.ts" },
        "version": { "const": 1 },
        "owner": { "const": "main" },
        "executor": { "const": "lisa-cron" },
        "operationalDeclarationCount": { "const": 19 },
        "separateMemoryDreamingRegistration": { "const": true },
        "excludedCronFamilies": { "const": ["librarian", "backup"] }
      }
    },
    "declarations": { "type": "array", "minItems": 19, "maxItems": 19, "uniqueItems": true, "items": { "type": "string" } },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "hardStops": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": true
}
