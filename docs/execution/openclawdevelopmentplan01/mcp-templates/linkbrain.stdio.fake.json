{
  "_comment": "FAKE ONLY — stdio Brain MCP pointing at repo fake. Do not copy into ~/.openclaw-lisa without Platform approval. enabled=false by default.",
  "mcp": {
    "servers": {
      "linkbrain": {
        "enabled": false,
        "transport": "stdio",
        "command": "node",
        "args": ["extensions/linkbrain/fake/server.mjs", "--stdio"],
        "cwd": "__OPENCLAW_PRIME_ROOT__",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 20000,
        "toolFilter": {
          "include": [
            "brain_browse",
            "brain_search",
            "brain_load",
            "brain_append_finding",
            "brain_capture_batch",
            "brain_episode_checkpoint",
            "brain_private_search",
            "brain_private_load",
            "brain_task_start",
            "brain_task_update",
            "brain_inbox_read",
            "brain_conflict_respond",
            "brain_message_send",
            "brain_checkpoint_write",
            "brain_handoff_create",
            "brain_handoff_accept",
            "brain_task_close"
          ]
        }
      }
    }
  }
}
