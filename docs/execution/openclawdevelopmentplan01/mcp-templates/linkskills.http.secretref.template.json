{
  "_comment": "TEMPLATE ONLY — HTTP Skills MCP with env-template SecretRef header. Never put real tokens here. enabled=false. URL is a non-routable placeholder.",
  "mcp": {
    "servers": {
      "linkskills": {
        "enabled": false,
        "transport": "streamable-http",
        "url": "https://skills.stage.example.invalid/mcp",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 20000,
        "headers": {
          "Authorization": "Bearer ${LINKTREND_LINKSKILLS_STAGE_MCP_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "skills_list",
            "skills_search",
            "skills_describe",
            "skills_fragment_get",
            "skills_release_get",
            "skills_run_start",
            "skills_run_update",
            "skills_run_complete",
            "skills_run_fail",
            "skills_tool_resolve",
            "skills_tool_invoke",
            "skills_input_validate",
            "skills_output_validate",
            "skills_feedback_submit",
            "skills_trace_candidate_submit"
          ]
        }
      }
    }
  },
  "_authNotes": {
    "preferred": "oauth.authProfileId when Platform issues OAuth-compatible MCP credentials",
    "fallbackSecretRefObject": {
      "source": "env",
      "provider": "default",
      "id": "LINKTREND_LINKSKILLS_STAGE_MCP_TOKEN"
    },
    "pluginCredentialSecretRef": {
      "path": "plugins.entries.linkskills.config.skillsCredential",
      "shape": {
        "source": "env",
        "provider": "default",
        "id": "LINKTREND_LINKSKILLS_STAGE_PLUGIN_TOKEN"
      },
      "rule": "Skills-only; never reuse Brain credential IDs"
    }
  }
}
