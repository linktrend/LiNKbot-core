{
  "_comment": "TEMPLATE ONLY — HTTP Brain MCP with env-template SecretRef header. Never put real tokens here. enabled=false. URL is a non-routable placeholder.",
  "mcp": {
    "servers": {
      "linkbrain": {
        "enabled": false,
        "transport": "streamable-http",
        "url": "https://brain.stage.example.invalid/mcp",
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 20000,
        "headers": {
          "Authorization": "Bearer ${LINKTREND_LINKBRAIN_STAGE_MCP_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "brain_browse",
            "brain_search",
            "brain_load",
            "brain_append_finding",
            "brain_capture_batch",
            "brain_episode_checkpoint",
            "brain_private_search",
            "brain_private_load",
            "brain_task_start",
            "brain_task_update",
            "brain_inbox_read",
            "brain_conflict_respond",
            "brain_message_send",
            "brain_checkpoint_write",
            "brain_handoff_create",
            "brain_handoff_accept",
            "brain_task_close"
          ]
        }
      }
    }
  },
  "_authNotes": {
    "preferred": "oauth.authProfileId when Platform issues OAuth-compatible MCP credentials",
    "fallbackSecretRefObject": {
      "source": "env",
      "provider": "default",
      "id": "LINKTREND_LINKBRAIN_STAGE_MCP_TOKEN"
    },
    "ingestionEndpointSecretRef": {
      "path": "plugins.entries.linkbrain.config.ingestionCredential",
      "shape": {
        "source": "env",
        "provider": "default",
        "id": "LINKTREND_LINKBRAIN_STAGE_INGESTION_TOKEN"
      },
      "rule": "Brain-only; never reuse Skills credential IDs"
    }
  }
}
