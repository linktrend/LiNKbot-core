{
  "id": "nemotron-shadow-eval",
  "name": "Nemotron Shadow Evaluation",
  "description": "Samples every Nth eligible Lisa text response for isolated, non-user-visible Nemotron comparison.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentId": { "type": "string", "default": "main" },
      "sessionKeys": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "sampleEvery": { "type": "integer", "minimum": 2, "maximum": 100, "default": 10 },
      "model": { "type": "string", "default": "openrouter/nvidia/nemotron-3-super-120b-a12b" },
      "maxPromptChars": { "type": "integer", "minimum": 1, "maximum": 12000, "default": 4000 },
      "maxOutputChars": { "type": "integer", "minimum": 1, "maximum": 4000, "default": 1000 },
      "maxTokens": { "type": "integer", "minimum": 1, "maximum": 2048, "default": 800 },
      "maxDailySamples": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
      "maxDailyCostUsd": { "type": "number", "minimum": 0, "maximum": 25, "default": 1 }
    }
  }
}
